# Password for the presenter screen (/present). Pick something only you know.
PRESENTER_KEY=change-me

# Redis storage. Add the Upstash Redis integration in Vercel
# (Storage > Upstash for Redis) and these are filled in for you.
# Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: change this to start a fresh session without wiping Redis.
SESSION_ID=symposium-2026

# Optional: the session title shown on screen.
NEXT_PUBLIC_SESSION_TITLE=Practical AI and agent use-case qualification
